# Auto detect text files and perform LF normalization
* text=auto

# Files executed inside Linux containers / on the server must keep LF endings,
# even when checked out on Windows with core.autocrlf=true.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.yml       text eol=lf
*.sql       text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary

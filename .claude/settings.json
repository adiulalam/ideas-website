{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose -f docker-compose.dev.yml *)",
      "Bash(npm run build:css)",
      "Bash(php bin/lint.php)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(docker compose up *)",
      "Bash(docker-compose up *)",
      "Bash(./deploy-ideas-website.sh *)",
      "Bash(bash deploy-ideas-website.sh *)",
      "Bash(bash ./deploy-ideas-website.sh *)"
    ],
    "deny": [
      "Read(./environment.php)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}

# Production settings for docker-compose.yml.
#
# Copy to ../.env on the server (one level above the checkout, next to the
# backups/ folder); deploy-ideas-website.sh copies it into place on every
# deploy. Never commit the real file. Wrap values in single quotes if they
# contain spaces, $, # or quotes (values containing ' are not supported).

# Public URL, used for links in emails.
APP_URL=https://ideas.adiulalamadil.me

# The stack's own MySQL database. The database and user are created on the
# very first start; changing these later does not rename or re-create them.
DB_DATABASE=ideas
DB_USERNAME=ideas
DB_PASSWORD=change-me-to-a-long-random-value
DB_ROOT_PASSWORD=change-me-to-another-long-random-value

# Gmail SMTP (leave MAIL_USERNAME empty to disable email).
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=gmail-app-password
# Where contact-form messages go (defaults to MAIL_USERNAME).
# CONTACT_TO=you@example.com

# Google reCAPTCHA v2.
CAPTCHA_SECRET_KEY=your-recaptcha-secret
# CAPTCHA_SITE_KEY=defaults-to-the-existing-public-key

# One-time import from an existing MySQL database. When LEGACY_DB_HOST is set
# and the stack's database has no tables yet, the deploy copies the data
# across (bin/import-legacy-db.sh). Harmless afterwards; remove when done.
# LEGACY_DB_HOST=172.17.0.1
# LEGACY_DB_PORT=3308
# LEGACY_DB_DATABASE=ideas
# LEGACY_DB_USERNAME=
# LEGACY_DB_PASSWORD=
